# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OMNIROUTE_API_KEY and OMNIROUTE_URL: Used by ProviderGateway
OMNIROUTE_API_KEY=""
OMNIROUTE_URL="https://api.omniroute.ai/v1"

# POLLINATIONS_API_KEY: Required for Pollinations image generation
POLLINATIONS_API_KEY=""

# EDGE_TTS_VOICE: Required for voice text-to-speech
EDGE_TTS_VOICE="en-US-EmmaMultilingualNeural"

# TAVILY_API_KEY: Required for Tavily Search API
TAVILY_API_KEY=""

# MAX_API_KEY, MAX_WEBHOOK_SECRET, and MAX_API_URL: Required for MAX messaging platform transport
MAX_API_KEY=""
MAX_WEBHOOK_SECRET=""
MAX_API_URL="https://api.max.com/v1/messages"
